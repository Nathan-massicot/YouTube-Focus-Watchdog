#!/usr/bin/env bash
# YouTube Focus Watchdog — Configuration
# This file is sourced by watchdog.sh at each execution

# Expiration date — enforcement stops after this date (format: YYYY-MM-DD).
# Set during installation by install.sh.
EXPIRY_DATE="2026-06-12"

# Absolute path to the Safari CSS stylesheet that Safari loads. The immutable
# backup the watchdog restores from lives beside it as .youtube-focus.css.bak.
CSS_PATH="/usr/local/etc/youtube-focus/youtube-focus.css"

# Safari sandboxed preferences plist, relative to each user's home.
# Must mirror the WatchPaths paths in install.sh.
SAFARI_CONTAINER_RELATIVE="Library/Containers/com.apple.Safari/Data/Library/Preferences/com.apple.Safari.plist"
