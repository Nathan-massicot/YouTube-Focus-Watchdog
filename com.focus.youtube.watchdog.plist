<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Unique identifier for the daemon -->
    <key>Label</key>
    <string>com.focus.youtube.watchdog</string>

    <!-- Command to execute: /bin/bash + path to watchdog.sh -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/usr/local/bin/watchdog.sh</string>
    </array>

    <!-- Run once when the daemon is loaded (at boot) -->
    <key>RunAtLoad</key>
    <true/>

    <!-- Event-driven enforcement: launchd starts the watchdog ONLY when one
         of these paths changes (created, modified, or deleted). No polling —
         the watchdog is completely idle while you watch videos.
         install.sh appends each user's sandboxed Safari preferences plist to
         this array, so toggling the stylesheet off in Safari triggers an
         immediate repair. -->
    <key>WatchPaths</key>
    <array>
        <string>/usr/local/etc/youtube-focus/youtube-focus.css</string>
        <string>/usr/local/etc/youtube-focus</string>
    </array>

    <!-- Safety net: one pass every 5 minutes catches anything WatchPaths
         could miss (atomic-rename edge cases) and lets the EXPIRY_DATE
         check take effect. One sub-second run per 5 minutes is
         imperceptible. -->
    <key>StartInterval</key>
    <integer>300</integer>

    <!-- Coalesce bursts of file events into at most one run per 5 seconds -->
    <key>ThrottleInterval</key>
    <integer>5</integer>

    <!-- No log files: stdout/stderr go to /dev/null by default -->

    <!-- Run as root (required to unlock/rewrite the immutable CSS and to write
         each user's Safari prefs via launchctl asuser) -->
    <key>UserName</key>
    <string>root</string>
</dict>
</plist>
