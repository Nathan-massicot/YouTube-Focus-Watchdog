	<array>
		<string>/usr/local/etc/youtube-focus/youtube-focus.css</string>
		<string>/usr/local/etc/youtube-focus</string>
		<string>/Users/nathanmassicot/Library/Containers/com.apple.Safari/Data/Library/Preferences/com.apple.Safari.plist</string>
	</array>
